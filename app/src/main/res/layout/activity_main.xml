<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：4 个入口按钮 + 返回结果 + 生命周期记录 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/PageTitle"
            android:text="@string/main_title" />

        <TextView
            style="@style/PageDesc"
            android:text="@string/main_subtitle" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_forward"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnInputReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_input_return"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_camera"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnStopWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_stopwatch"
            android:textAllCaps="false" />

        <!-- 第 2 个二级 Activity 的返回结果 -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                style="@style/CardLabel"
                android:text="@string/label_returned" />

            <TextView
                android:id="@+id/tvReturnedValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/primary_text"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- 生命周期记录 -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                style="@style/CardLabel"
                android:text="@string/label_lifecycle" />

            <TextView
                android:id="@+id/tvLifecycleLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/primary_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
